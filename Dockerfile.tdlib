# Dockerfile for building TDLib static libraries
#
# Build TDLib in a reproducible environment:
#   docker build -f Dockerfile.tdlib -t tlgram-tdlib-builder .
#   docker run --rm -v $(pwd)/tdlib-out:/out tlgram-tdlib-builder
#
# This will produce TDLib libraries in tdlib-out/

FROM ubuntu:22.04 AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    gperf \
    git \
    libssl-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# TDLib version to build
ARG TDLIB_VERSION=v1.8.31

# Clone and build TDLib
WORKDIR /td
RUN git clone --depth 1 --branch $TDLIB_VERSION https://github.com/tdlib/td.git .

WORKDIR /td/build
RUN cmake -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_INSTALL_PREFIX=/opt/tdlib \
          -DTD_ENABLE_LTO=ON \
          .. \
    && cmake --build . --target tdjson_static -j$(nproc) \
    && cmake --install .

# Output stage
FROM scratch AS output
COPY --from=builder /opt/tdlib /out/tdlib

# Default command copies libraries to mounted volume
FROM ubuntu:22.04
COPY --from=builder /opt/tdlib /opt/tdlib
CMD ["cp", "-r", "/opt/tdlib/.", "/out/"]
